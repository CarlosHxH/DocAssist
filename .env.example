# Configuração do DocAssist. Copie para `.env` e ajuste:  cp .env.example .env
# Variáveis definidas no ambiente (ex.: docker-compose) têm prioridade sobre este arquivo.

# --- API de IA ---------------------------------------------------------------------------
# ollama -> API nativa do Ollama (/api/embeddings, /api/generate)
# openai -> qualquer API compatível com OpenAI (/v1/embeddings, /v1/chat/completions):
#           OpenAI (https://api.openai.com), LM Studio, vLLM, LiteLLM, Ollama em modo /v1...
LLM_PROVIDER=ollama
# URL base da API, sem barra no final e sem /v1 (o cliente acrescenta o caminho).
LLM_API_URL=http://localhost:11434
# Chave enviada como "Authorization: Bearer <chave>". Deixe vazio para Ollama local.
LLM_API_KEY=
REQUEST_TIMEOUT_SECONDS=120

# --- Modelos -----------------------------------------------------------------------------
# Trocar EMBEDDING_MODEL exige reindexar: `python src/ingest.py`.
EMBEDDING_MODEL=all-minilm
GENERATION_MODEL=qwen2.5:3b
GENERATION_TEMPERATURE=0.1

# --- Docker ------------------------------------------------------------------------------
# docker-compose.yml: URL da API vista de dentro do container (se LLM_API_URL usar localhost).
# LLM_API_URL_DOCKER=http://host.docker.internal:11434
# docker-compose.local.yml: modelos baixados/usados no Ollama do compose.
# OLLAMA_EMBEDDING_MODEL=all-minilm
# OLLAMA_GENERATION_MODEL=qwen2.5:3b

# --- Banco vetorial ----------------------------------------------------------------------
# chroma -> ChromaDB persistente em SQLite (CHROMA_PATH), sem servidor
# qdrant -> servidor Qdrant (QDRANT_URL), via API REST
# Trocar de banco exige indexar de novo: `python src/ingest.py`.
VECTOR_STORE=qdrant
VECTOR_COLLECTION=docassist
CHROMA_PATH=chroma_db
# URL base do Qdrant, sem barra no final (porta 6333 em instalações padrão).
QDRANT_URL=http://qdrant.172-17-41-166.sslip.io
# Enviada no header "api-key". Deixe vazio se o Qdrant não exigir autenticação.
QDRANT_API_KEY=

# --- Ingestão e recuperação --------------------------------------------------------------
RAG_DIR=rag
# Tamanho máximo de cada trecho; aumente se o modelo de embeddings tiver janela maior.
MAX_CHUNK_CHARS=500
TOP_K=4
# Similaridade de cosseno mínima para responder (recalibre ao trocar o modelo de embeddings).
SIMILARITY_THRESHOLD=0.40

# --- Logs --------------------------------------------------------------------------------
# Pasta de logs: docassist.log (operacional, JSON) e interactions.jsonl (uma linha por pergunta).
LOG_DIR=logs
# DEBUG mostra também health checks, arquivos estáticos e cada chamada à API de IA.
LOG_LEVEL=INFO
# Formato do console: text ou json (útil no Docker, para coletores de log).
LOG_FORMAT=text
# Rotação: tamanho máximo de cada arquivo (bytes) e quantos arquivos antigos manter.
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
